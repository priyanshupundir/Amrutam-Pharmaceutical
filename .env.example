# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amrutam_telemedicine
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONN_TIMEOUT_MS=5000

# Cache & Distributed Lock (Redis)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=amrutam:

# Security & Authentication
JWT_SECRET=amrutam_telemedicine_super_secure_jwt_access_secret_2026_min32bytes!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=amrutam_telemedicine_super_secure_jwt_refresh_secret_2026_min32bytes!
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Cryptography & Healthcare Compliance (HIPAA / DISHA)
# PHI_ENCRYPTION_KEY: 64-character hex string (32 bytes) for AES-256-GCM
PHI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# AUDIT_HMAC_SECRET: Cryptographic secret for tamper-evident hash chaining
AUDIT_HMAC_SECRET=amrutam_tamper_evident_audit_log_hmac_secret_key_2026

# Rate Limiting & Resilience
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
CIRCUIT_BREAKER_TIMEOUT_MS=3000
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
